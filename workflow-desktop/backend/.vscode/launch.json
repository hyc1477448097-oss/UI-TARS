{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug Backend",
      "type": "python",
      "request": "launch",
      "module": "uvicorn",
      "args": [
        "app.main:app",
        "--reload",
        "--host", "127.0.0.1",
        "--port", "8000"
      ],
      "cwd": "${workspaceFolder}",
      "env": {
        "ARK_API_KEY": "${env:ARK_API_KEY}"
      },
      "console": "integratedTerminal",
      "justMyCode": false
    }
  ]
}
